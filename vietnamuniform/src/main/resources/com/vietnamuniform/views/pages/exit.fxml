<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vietnamuniform.controller.ExitController"
            prefHeight="200.0" prefWidth="400.0"
            style="-fx-background-color: white; -fx-border-radius: 10px; -fx-padding: 20px;"
            stylesheets="@../styles/exit.css">

    <children>
        <Label layoutX="120.0" layoutY="50.0" text="Bạn có chắc chắn muốn thoát không ?"
               style="-fx-font-size: 16px; -fx-font-weight: bold;" />

        <Button fx:id="btnYes" text="Có" layoutX="100.0" layoutY="120.0" prefWidth="80"
                onAction="#handleExit" />

        <Button fx:id="btnNo" text="Không" layoutX="220.0" layoutY="120.0" prefWidth="80"
                onAction="#handleCancel" />


    </children>

</AnchorPane>
