<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1024.0" style="-fx-background-color: #fff;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vietnamuniform.controller.LoginController">
    <children>
        <BorderPane prefHeight="600.0" prefWidth="1024.0" style="-fx-background-color: #fff;">
            <!-- Left Panel with Background Image -->
            <left>
                <Pane prefHeight="600.0" prefWidth="512.0"
                      style="-fx-background-image: url('/com/vietnamuniform/views/images/aodailogin.jpg'); -fx-background-size: cover;"
                      BorderPane.alignment="CENTER" />
            </left>
            <!-- Center Panel with Login Form -->
            <center>
                <Pane prefHeight="600.0" prefWidth="512.0" BorderPane.alignment="CENTER">
                    <children>
                        <VBox alignment="CENTER" layoutX="50.0" layoutY="50.0"
                              prefHeight="500.0" prefWidth="412.0" spacing="20.0">
                            <children>
                                <!-- Title -->
                                <Label text="Vietnam Uniform">
                                    <font>
                                        <Font size="24.0" />
                                    </font>
                                </Label>
                                <!-- Username Field -->
                                <Label text="Username">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="usernameField" prefHeight="45.0" prefWidth="331.0"
                                           promptText="Enter your username" />
                                <!-- Password Field -->
                                <Label text="Password">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <PasswordField fx:id="passwordField" prefHeight="45.0" prefWidth="331.0"
                                               promptText="Enter 4 characters or more" />
                                <!-- Buttons -->
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="loginButton" mnemonicParsing="false"
                                                onAction="#handleLogin" prefHeight="44.0" prefWidth="133.0"
                                                style="-fx-background-color: #8B4513;"
                                                text="Sign in" textFill="WHITE" />
                                    </children>
                                </HBox>
                                <!-- Forgot Password Link -->
                                <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="144.0"
                                        style="-fx-background-color: transparent; -fx-border-color: transparent;"
                                        text="Forgot password?" />
                                <!-- Error Message -->
                                <Label fx:id="ErrorField" alignment="CENTER" prefHeight="41.0" prefWidth="331.0"
                                       textFill="RED">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </Pane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>