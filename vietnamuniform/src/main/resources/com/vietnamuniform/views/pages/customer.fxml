<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" pannable="true" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vietnamuniform.controller.CustomerController">
    <content>
        <AnchorPane minHeight="400" minWidth="900" style="-fx-background-color: white; -fx-font-size: 13px;" stylesheets="@../styles/product.css">
            <children>
                <!-- Thanh tìm kiếm -->
                <TextField fx:id="searchField" layoutX="50" layoutY="20" prefWidth="300" promptText="Tìm kiếm...">
                    <font>
                        <Font size="15.0" />
                    </font>
                </TextField>
                <Button fx:id="searchButton" layoutX="360" layoutY="15" style="-fx-font-size: 20px;" text="🔍" />

                <!-- Trường nhập Mã khách hàng -->
                <TextField fx:id="txtCodeCustomer" layoutX="50" layoutY="60" prefWidth="225" promptText="Mã KH" />

                <!-- Trường nhập Họ và Tên -->
                <TextField fx:id="txtFullname" layoutX="300" layoutY="60" prefWidth="225" promptText="Họ và tên" />

                <!-- Trường nhập Địa chỉ -->
                <TextField fx:id="txtAddress" layoutX="550" layoutY="60" prefWidth="225" promptText="Địa chỉ" />

                <!-- ComboBox Giới tính -->
                <ComboBox fx:id="cmbGender" layoutX="800" layoutY="60" prefWidth="225" promptText="Giới tính">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Men" />
                            <String fx:value="Women" />
                            <String fx:value="Oth" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <!-- Trường nhập Số điện thoại -->
                <TextField fx:id="txtPhone" layoutX="50" layoutY="100" prefWidth="225" promptText="Số điện thoại" />

                <!-- ComboBox Loại khách hàng -->
                <ComboBox fx:id="cmbCustomerType" layoutX="300" layoutY="100" prefWidth="225" promptText="Loại khách hàng" >
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Sinh viên" />
                            <String fx:value="VIP" />
                            <String fx:value="Thường" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <!-- Các nút thao tác -->
                <Button fx:id="btnAdd" layoutX="50" layoutY="140" style="-fx-background-color: green; -fx-background-radius:3px;" text="➕ Thêm" textFill="WHITE" onAction="#addCustomer" />
                <Button fx:id="btnUpdate" layoutX="150" layoutY="140" style="-fx-background-color: blue; -fx-background-radius:3px;" text="✏️ Sửa" textFill="WHITE" onAction="#updateCustomer" />
                <Button fx:id="btnDelete" layoutX="250" layoutY="140" style="-fx-background-color: red; -fx-background-radius:3px;" text="❌ Xóa" textFill="WHITE" onAction="#deleteCustomer" />
                <!-- Bảng danh sách khách hàng -->
                <TableView fx:id="customerTable" layoutX="-3.0" layoutY="181.0" prefHeight="599.0" prefWidth="1114.0">
                    <columns>
                        <TableColumn fx:id="colCodeCustomer" prefWidth="112.0" text="Mã KH" />
                        <TableColumn fx:id="colFullname" prefWidth="185.333" text="Họ và tên" />
                        <TableColumn fx:id="colAddress" prefWidth="173.333" text="Địa chỉ" />
                        <TableColumn fx:id="colGender" prefWidth="111.333" text="Giới tính" />
                        <TableColumn fx:id="colPhone" prefWidth="160.0" text="Số điện thoại" />
                        <TableColumn fx:id="colCustomerType" prefWidth="149.333" text="Loại khách hàng" />
<!--                        <TableColumn fx:id="colAction" prefWidth="167.999" text="Hành động" />-->
                    </columns>
                </TableView>

                <!-- Thanh phân trang -->
                <Pagination fx:id="pagination" layoutX="99.0" layoutY="793.0" maxPageIndicatorCount="5" prefHeight="50" prefWidth="1100" style="-fx-border-color: none;">
                    <cursor>
                        <Cursor fx:constant="DEFAULT" />
                    </cursor>
                </Pagination>
            </children>
        </AnchorPane>
    </content>
</ScrollPane>
