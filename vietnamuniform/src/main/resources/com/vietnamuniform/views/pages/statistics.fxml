<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vietnamuniform.controller.StatisticsController"
            prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../styles/statistic.css">
    <children>
        <TabPane layoutX="10.0" layoutY="10.0"  >
            <!-- Tab 1: Thống kê doanh thu -->
            <Tab text="Thống kê doanh thu">
                <AnchorPane prefWidth="1200" prefHeight="500">
                    <DatePicker fx:id="startDatePicker" layoutX="10" layoutY="20" promptText="Từ ngày"/>
                    <DatePicker fx:id="endDatePicker" layoutX="250" layoutY="20" promptText="Đến ngày"/>
                    <Button styleClass="searchButton" layoutX="510" layoutY="30" style="-fx-font-size: 20px;" text="🔍" onAction="#searchRevenueStatistics" />
                    <TableView fx:id="revenueTable" layoutX="5.0" layoutY="100.0"  prefHeight="500.0">
                        <columns>
                            <TableColumn text="Ngày lập" fx:id="colDate" prefWidth="120"/>
                            <TableColumn text="Tổng sản phẩm" fx:id="colTotalProducts" prefWidth="120"/>
                            <TableColumn text="Tổng tiền đơn hàng" fx:id="colTotalAmount" prefWidth="150"/>
                            <TableColumn text="Mã nhân viên" fx:id="colEmployeeCode" prefWidth="100"/>
                            <TableColumn text="Tên nhân viên" fx:id="colEmployeeName" prefWidth="150"/>
                        </columns>
                    </TableView>
                </AnchorPane>
            </Tab>

            <!-- Tab 2: Thống kê nhân viên -->
            <Tab text="Thống kê nhân viên">
                <AnchorPane prefWidth="1200" prefHeight="500">
                    <TextField fx:id="searchEmployeeField" layoutX="10" layoutY="20" promptText="Nhập tên nhân viên"/>
                    <Button styleClass="searchButton" layoutX="250" layoutY="20" style="-fx-font-size: 20px;" text="🔍" onAction="#searchEmployeeStatistics" />
                    <TableView fx:id="employeeTable" layoutX="5.0" layoutY="100.0"  prefHeight="500.0">
                        <columns>
                            <TableColumn text="Mã thống kê" fx:id="colStatId" prefWidth="100"/>
                            <TableColumn text="Mã nhân viên" fx:id="colEmployeeCodeEmp" prefWidth="100"/>
                            <TableColumn text="Tên nhân viên" fx:id="colEmployeeNameEmp" prefWidth="150"/>
                            <TableColumn text="Số hóa đơn" fx:id="colTotalOrders" prefWidth="120"/>
                            <TableColumn text="Tổng tiền đơn hàng" fx:id="colTotalOrderAmount" prefWidth="150"/>
                            <TableColumn text="Mã sản phẩm" fx:id="colProductCodeEmp" prefWidth="120"/>
                            <TableColumn text="Tên sản phẩm" fx:id="colProductNameEmp" prefWidth="150"/>
                            <TableColumn text="Giá nhập" fx:id="colImportPrice" prefWidth="100"/>
                            <TableColumn text="Giá bán" fx:id="colSalePrice" prefWidth="100"/>
                            <TableColumn text="Số lượng bán" fx:id="colQuantitySold" prefWidth="120"/>
                        </columns>
                    </TableView>
                </AnchorPane>
            </Tab>

            <!-- Tab 3: Thống kê sản phẩm -->
            <Tab text="Thống kê sản phẩm">
                <AnchorPane prefWidth="1200" prefHeight="500">
                    <TextField fx:id="searchProductField" layoutX="10" layoutY="20" promptText="Nhập tên sản phẩm"/>
                    <Button styleClass="searchButton" layoutX="250" layoutY="20" style="-fx-font-size: 20px;" text="🔍" onAction="#searchProductStatistics" />
                    <TableView fx:id="productTable" layoutX="5.0" layoutY="100.0"  prefHeight="500.0">
                        <columns>
                            <TableColumn text="Mã sản phẩm" fx:id="colProductCode" prefWidth="120"/>
                            <TableColumn text="Tên sản phẩm" fx:id="colProductName" prefWidth="150"/>
                            <TableColumn text="Chi tiết sản phẩm" fx:id="colProductDetail" prefWidth="200"/>
                            <TableColumn text="Size" fx:id="colSize" prefWidth="80"/>
                            <TableColumn text="Tổng sản phẩm" fx:id="colTotalStock" prefWidth="120"/>
                            <TableColumn text="Số lượng bán" fx:id="colQuantitySoldProd" prefWidth="120"/>
                            <TableColumn text="Số lượng còn" fx:id="colQuantityRemaining" prefWidth="120"/>
                        </columns>
                    </TableView>
                </AnchorPane>
            </Tab>
        </TabPane>
    </children>
</AnchorPane>
