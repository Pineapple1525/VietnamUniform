<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vietnamuniform.controller.StatisticsController"
            prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../styles/statistic.css">
    <children>
        <TabPane layoutX="10.0" layoutY="10.0"  >
            <!-- Tab 1: Thống kê doanh thu -->
            <Tab text="Thống kê doanh thu">
                <AnchorPane prefWidth="1200" prefHeight="500">
                    <DatePicker fx:id="startDatePicker" layoutX="10" layoutY="20" promptText="Từ ngày"/>
                    <DatePicker fx:id="endDatePicker" layoutX="250" layoutY="20" promptText="Đến ngày"/>
                   <Button styleClass="searchButton" layoutX="510" layoutY="30" style="-fx-font-size: 20px;" text="🔍" onAction="#searchRevenueStatistics" />
                    <TableView fx:id="revenueStatisticsTable" layoutX="5.0" layoutY="100.0"  prefHeight="500.0">
                        <columns>
                            <TableColumn text="ID" fx:id="colRevenueStatId" prefWidth="120"/>
                            <TableColumn text="Ngày lập" fx:id="colRevenueReportDate" prefWidth="120"/>
                            <TableColumn text="Tổng SP Bán" fx:id="colTotalProductsSoldRevenue"  prefWidth="150"/>
                            <TableColumn text="Tổng Doanh Thu" fx:id="colTotalRevenueDay" prefWidth="100"/>
                            <TableColumn text="Mã NV" fx:id="colRevenueEmployeeCode" prefWidth="150"/>
                            <TableColumn text="Tên NV" fx:id="colRevenueEmployeeName" prefWidth="150"/>
                        </columns>
                    </TableView>
                </AnchorPane>
            </Tab>

            <!-- Tab 2: Thống kê nhân viên -->
            <Tab text="Thống kê nhân viên">
                <AnchorPane prefWidth="1200" prefHeight="500">
                    <TextField fx:id="searchEmployeeField" layoutX="10" layoutY="20" promptText="Nhập tên nhân viên"/>
                    <Button styleClass="searchButton" layoutX="250" layoutY="20" style="-fx-font-size: 20px;" text="🔍" onAction="#searchEmployeeStatistics" />
                    <TableView fx:id="employeeStatisticsTable" layoutX="5.0" layoutY="100.0"  prefHeight="500.0">
                        <columns>
                            <TableColumn text="ID" fx:id="colEmployeeStatId" prefWidth="100"/>
                            <TableColumn text="Ngày lập" fx:id="colEmployeeReportDate" prefWidth="100"/>
                            <TableColumn text="Mã NV" fx:id="colEmployeeCode" prefWidth="100"/>
                            <TableColumn text="Tên NV" fx:id="colEmployeeName" prefWidth="100"/>
                            <TableColumn text="Tổng đơn" fx:id="colTotalOrders" prefWidth="100"/>
                            <TableColumn text="Doanh thu" fx:id="colTotalRevenue" prefWidth="100"/>
                            <TableColumn text="Mã SP" fx:id="colSoldProductCode" prefWidth="100"/>
                            <TableColumn text="Tên SP" fx:id="colSoldProductName" prefWidth="100"/>
                            <TableColumn text="Giá nhập" fx:id="colImportPrice" prefWidth="100"/>
                            <TableColumn text="Giá bán" fx:id="colSalePrice" prefWidth="100"/>
                            <TableColumn text="SL đã bán" fx:id="colTotalProductsSold" prefWidth="100"/>
                        </columns>
                    </TableView>
                </AnchorPane>
            </Tab>

            <!-- Tab 3: Thống kê sản phẩm -->
            <Tab text="Thống kê sản phẩm">
                <AnchorPane prefWidth="1200" prefHeight="500">
                    <TextField fx:id="searchProductField" layoutX="10" layoutY="20" promptText="Nhập tên sản phẩm"/>
                    <Button styleClass="searchButton" layoutX="250" layoutY="20" style="-fx-font-size: 20px;" text="🔍" onAction="#searchProductStatistics" />
                    <TableView fx:id="productStatisticsTable" layoutX="5.0" layoutY="100.0"  prefHeight="500.0">
                        <columns>
                            <TableColumn text="ID" fx:id="colProductId"  prefWidth="120"/>
                            <TableColumn text="Mã SP" fx:id="colProductCode" prefWidth="150"/>
                            <TableColumn text="Tên SP" fx:id="colProductName" prefWidth="200"/>
                            <TableColumn text="Chi tiết" fx:id="colProductDetails" prefWidth="80"/>
                            <TableColumn text="Kích cỡ" fx:id="colProductSize" prefWidth="120"/>
                            <TableColumn text="SL Nhập" fx:id="colTotalImport" prefWidth="120" />
                            <TableColumn text="SL Đã Bán" fx:id="colTotalSold" prefWidth="120"/>
                            <TableColumn text="SL Còn" fx:id="colRemainingStock" prefWidth="120"/>
                        </columns>
                    </TableView>
                </AnchorPane>
            </Tab>
        </TabPane>
    </children>
</AnchorPane>
