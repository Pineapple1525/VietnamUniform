<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vietnamuniform.controller.ExitController"
            prefHeight="200.0" prefWidth="400.0"
            style="-fx-background-color: white; -fx-border-radius: 10px; -fx-padding: 20px;">

    <children>
        <Label layoutX="120.0" layoutY="50.0" text="Are you sure you want to exit?"
               style="-fx-font-size: 16px; -fx-font-weight: bold;" />

        <Button fx:id="btnYes" text="Yes" layoutX="100.0" layoutY="120.0" prefWidth="80"
                onAction="#handleExit"
                style="-fx-background-color: red; -fx-text-fill: white; -fx-font-size: 14px;" />

        <Button fx:id="btnNo" text="No" layoutX="220.0" layoutY="120.0" prefWidth="80"
                onAction="#handleCancel"
                style="-fx-background-color: green; -fx-text-fill: white; -fx-font-size: 14px;" />

    </children>

</AnchorPane>
